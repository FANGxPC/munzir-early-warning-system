# ==============================================================================
# Munzir (منذر) — Environment Configuration Template
# Copy this file to '.env' and populate with your production or local keys:
#   cp .env.example .env
# ==============================================================================

# --- 1. OpenAQ Ambient Air Quality API v3 ---
# Obtain your free API key at: https://explore.openaq.org/register
# If left empty, Munzir automatically uses local ground-station caching and fallback simulation.
OPENAQ_API_KEY=

# --- 2. Sentinel ESP32 Hardware Authentication ---
# Shared secret token used in 'X-Sentinel-Key' HTTP header by ESP32 nodes
SENTINEL_API_KEY=munzir_sentinel_secret_2026

# --- 3. Central Server Host Binding ---
PORT=8000
HOST=0.0.0.0

# --- 4. Azure for Students Deployment Configuration ---
RESOURCE_GROUP=rg-munzir-student
LOCATION=eastus
APP_NAME=munzir-live
